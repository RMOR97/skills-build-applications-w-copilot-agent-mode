# OctoFit Tracker Backend Environment Variables

# Server Port
PORT=8000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/octofit_db

# CORS Configuration (Optional)
# Add additional allowed origins separated by commas
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
# ALLOWED_ORIGINS=

# Node Environment
NODE_ENV=development

# JWT Configuration (for authentication)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# GitHub Codespaces Support (Auto-detected)
# The backend automatically detects CODESPACE_NAME environment variable
# and constructs the API URL accordingly:
# - Codespaces: https://$CODESPACE_NAME-8000.app.github.dev
# - Localhost: http://localhost:8000
