# OctoFit Tracker Frontend Environment Variables

# API Port (backend)
API_PORT=8000

# GitHub Codespaces Support (Auto-detected)
# The frontend automatically detects CODESPACE_NAME environment variable
# through Vite's build process and constructs the API URL:
# - Codespaces: https://$CODESPACE_NAME-8000.app.github.dev/api
# - Localhost: http://localhost:8000/api

# Vite Server Config
VITE_API_BASE_URL=http://localhost:8000
